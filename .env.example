# .env de la prueba local: cp .env.example .env y docker compose up.
# Grocy no necesita secretos para correr; aquí no va ninguno.

# Nombre del proyecto en Compose: también nombra el volumen
# (<proyecto>_datos, donde vive data/ con grocy.db y las fotos)
COMPOSE_PROJECT_NAME=grocy-local
COMPOSE_FILE=compose.local.yml

# grocy-<tema> si se prueba desde el worktree de un sprint
GROCY_CONTENEDOR=grocy-local
# Puerto en localhost; uno distinto por worktree
GROCY_PUERTO=8090
